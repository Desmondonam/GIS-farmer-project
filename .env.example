APP_NAME=agri-intelligence-platform
APP_ENV=development
APP_DEBUG=true

POSTGRES_DB=agri_db
POSTGRES_USER=agri_user
POSTGRES_PASSWORD=agri_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

COPERNICUS_API_URL=https://finder.creodias.eu
COPERNICUS_API_KEY=
WEATHER_API_KEY=

DEMO_MODE=true
LIVE_DATA_MODE=false

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: regex to also allow Vercel's per-deploy preview subdomains, e.g.
# https://agri-intelligence-frontend.*\.vercel\.app
CORS_ALLOWED_ORIGIN_REGEX=

# Frontend only (frontend/.env or set as a Vercel project env var) — the
# deployed backend's base URL. Defaults to http://localhost:8000 if unset.
VITE_API_BASE_URL=http://localhost:8000
